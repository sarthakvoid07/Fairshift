# Copy to .env for local runs, or set these on Cloud Run. Never commit real values.

# Signs sessions, check-in QR codes and skill-passport links. Use a long random string.
SESSION_SECRET=

# Optional. Enables Gemini triage, translation and weekly briefs. The app works fully without it.
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest.
GEMINI_MODEL=

# Optional. Public base URL used inside check-in QR codes, e.g. https://fairshift-xyz.a.run.app
PUBLIC_URL=
